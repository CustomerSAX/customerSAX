{
  "name": "@csa/merchant-center-app",
  "version": "1.0.0",
  "description": "Standalone CSA B2C Merchant Center Custom Application",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "mc-scripts build",
    "start": "mc-scripts start",
    "compile-html": "mc-scripts compile-html",
    "compile-html:local": "MC_APP_ENV=development mc-scripts compile-html --transformer @commercetools-frontend/mc-dev-authentication/transformer-local.js",
    "start:prod:local": "pnpm compile-html:local && mc-scripts serve",
    "test": "node --test tests/*.test.mjs && jest --config jest.test.config.js",
    "test:watch": "jest --config jest.test.config.js --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.{js,mjs,ts,tsx}'"
  },
  "dependencies": {
    "@apollo/client": "3.14.1",
    "@babel/core": "^7.29.0",
    "@babel/runtime-corejs3": "^7.29.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@commercetools-frontend/actions-global": "^27.17.1",
    "@commercetools-frontend/application-components": "^27.17.1",
    "@commercetools-frontend/application-config": "^27.17.1",
    "@commercetools-frontend/application-shell": "^27.17.1",
    "@commercetools-frontend/application-shell-connectors": "^27.17.1",
    "@commercetools-frontend/assets": "^27.17.1",
    "@commercetools-frontend/constants": "^27.17.1",
    "@commercetools-frontend/eslint-config-mc-app": "^27.17.1",
    "@commercetools-frontend/i18n": "^27.17.1",
    "@commercetools-frontend/jest-preset-mc-app": "^27.17.1",
    "@commercetools-frontend/mc-dev-authentication": "^27.17.1",
    "@commercetools-frontend/mc-scripts": "^27.17.1",
    "@commercetools-frontend/permissions": "^27.17.1",
    "@commercetools-frontend/sdk": "^27.17.1",
    "@commercetools-uikit/collapsible-panel": "^20.6.7",
    "@commercetools-uikit/constraints": "^20.6.7",
    "@commercetools-uikit/data-table": "^20.6.7",
    "@commercetools-uikit/flat-button": "^20.6.7",
    "@commercetools-uikit/grid": "^20.6.7",
    "@commercetools-uikit/hooks": "^20.6.7",
    "@commercetools-uikit/icons": "^20.6.7",
    "@commercetools-uikit/loading-spinner": "^20.6.7",
    "@commercetools-uikit/notifications": "^20.6.7",
    "@commercetools-uikit/pagination": "^20.6.7",
    "@commercetools-uikit/primary-button": "^20.6.7",
    "@commercetools-uikit/select-field": "^20.6.7",
    "@commercetools-uikit/spacings": "^20.6.7",
    "@commercetools-uikit/text": "^20.6.7",
    "@commercetools-uikit/text-field": "^20.6.7",
    "@commercetools/nimbus": "3.8.0",
    "@formatjs/cli": "6.16.35",
    "@graphql-eslint/eslint-plugin": "^4.4.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "eslint": "^9.39.5",
    "graphql": "16.14.2",
    "graphql-tag": "^2.12.7",
    "jest": "30.5.2",
    "prettier": "2.8.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-intl": "^7.1.14",
    "react-redux": "9.3.0",
    "react-router-dom": "5.3.4",
    "redux": "5.0.1",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@types/react-router": "<6",
    "@types/react-router-dom": "<6"
  }
}
