NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
AUTH_SERVICE_URL=http://localhost:4360
AUTH_COOKIE_NAME=csa_session

# Superadmin platform-admin feature (client orgs, projects, users, SMTP,
# SSO config). Reads/writes the same MongoDB the auth service uses — see
# apps/auth/.env.example for the canonical collection names, which this
# mirrors.
MONGO_URI=
MONGO_ADMIN_DB=csa-admin
MONGO_ADMIN_COLLECTION=csa_clients
MONGO_PROJECTS_COLLECTION=csa_projects
MONGO_SMTP_PROFILES_COLLECTION=csa_smtp_profiles
MONGO_AGENTS_DB=csa-agents
MONGO_USERS_COLLECTION=csa_users
# Shared secret gating POST /api/superadmin/seed (bootstraps the first
# superadmin account). Matches apps/auth's SEED_SECRET.
SEED_SECRET=
# AES-256-GCM key for encrypting stored commerce/SMTP credentials at rest.
SUPERADMIN_ENCRYPTION_KEY=
