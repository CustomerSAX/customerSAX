{
  "name": "@csa/docs-site",
  "version": "0.1.0",
  "private": true,
  "description": "customerSAX public documentation portal (Fumadocs). Intended domain: docs.customersax.com",
  "scripts": {
    "clean": "rm -rf .next .source",
    "predev": "fumadocs-mdx",
    "dev": "next dev -p 3001",
    "prebuild": "fumadocs-mdx",
    "build": "next build",
    "start": "next start -p 3001",
    "postinstall": "fumadocs-mdx",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@csa/ui": "workspace:*",
    "@fontsource-variable/inter": "^5.1.0",
    "fumadocs-core": "15.8.5",
    "fumadocs-mdx": "11.10.1",
    "fumadocs-ui": "15.8.5",
    "mermaid": "^11.4.1",
    "next": "^15.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@csa/config-typescript": "workspace:*",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.5.4"
  }
}
