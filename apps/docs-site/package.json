{
  "name": "@csa/docs-site",
  "version": "0.1.0",
  "private": true,
  "description": "customerSAX public documentation portal (Fumadocs). Intended domain: docs.customersax.com",
  "scripts": {
    "clean": "rm -rf .next .source",
    "predev": "fumadocs-mdx",
    "dev": "next dev -p 3001",
    "prebuild": "fumadocs-mdx",
    "build": "next build --webpack",
    "start": "next start -p 3001",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@csa/ui": "workspace:*",
    "@fontsource-variable/inter": "^5.1.0",
    "fumadocs-core": "16.14.0",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.14.0",
    "mermaid": "^11.4.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@csa/config-typescript": "workspace:*",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.14.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.5.4"
  }
}
