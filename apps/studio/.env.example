NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
AUTH_SERVICE_URL=http://localhost:4360
NEXT_PUBLIC_ENABLE_AGENTS_NAV=false
AUTH_COOKIE_NAME=csa_session

# The one commercetools project this deployment is wired to — must match
# COMMERCETOOLS_PROJECT_KEY in apps/commerce/commercetools/.env. No fallback
# in source if left unset.
NEXT_PUBLIC_CT_PROJECT_KEY=
NEXT_PUBLIC_CT_BUSINESS_TYPE=

# Structured logging level (@csa/logger): error | warn | info | debug
LOG_LEVEL=info
