TICKETING_PORT=4350
MONGO_URI=
MONGO_DB_NAME=csa
MONGO_TICKETS_COLLECTION=Tickets

# Structured logging level (@csa/logger): error | warn | info | debug
LOG_LEVEL=info

# Superadmin project settings: use the same admin database and encryption key as admin.
# Authenticated client/project requests use saved settings (default: native).
# Optional separate settings cluster; blank uses MONGO_URI.
MONGO_ADMIN_URI=
MONGO_ADMIN_DB=csa-admin
SUPERADMIN_ENCRYPTION_KEY=

# Local native-ticket email pilot. Keep secrets in .env, never NEXT_PUBLIC_*.
TICKET_EMAIL_ENABLED=false
TICKET_EMAIL_PROVIDER=sendgrid
# Project and client are taken automatically from the active Studio session.
SENDGRID_API_KEY=
TICKET_EMAIL_FROM=
# Optional monitored mailbox; automatic reply ingestion is not implemented yet.
TICKET_EMAIL_REPLY_TO=

# Automatically analyze newly created native tickets and request missing details.
# Defaults to true when email is enabled; false restores generic confirmations only.
TICKET_EMAIL_AI_FOLLOWUP_ENABLED=true
AI_ASSIST_URL=http://localhost:8080

# Backend deployment mounts this shared Secret Manager document automatically.
# Contains Hub URL/execution key and explicit client-to-tenant registrations.
# Provider credentials and action selection belong to Hub, not this service.
CONNECTION_HUB_PLATFORM_CONFIG=

# Optional local-development transport (existing configuration remains supported).
CONNECTION_HUB_ENABLED=false
CONNECTION_HUB_URL=http://127.0.0.1:3100
CONNECTION_HUB_API_KEY=
CONNECTION_HUB_CLIENT_ID=
# Assistant Zendesk plugin: match Studio's mode, execution key and tenant mapping.
USE_CONNECTION_HUB_PROD=false
CONNECTION_HUB_TENANT_ID=
CONNECTION_HUB_PROD_URL=
CONNECTION_HUB_PROD_API_KEY=
CONNECTION_HUB_PROD_TENANT_ID=
