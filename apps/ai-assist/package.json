{
  "name": "@csa/ai-assist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "tf:check": "terraform fmt -check -recursive terraform",
    "tf:format": "terraform fmt -recursive terraform",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.33",
    "@csa/cache": "workspace:*",
    "@csa/config": "workspace:*",
    "@csa/headers": "workspace:*",
    "@csa/logger": "workspace:*",
    "@csa/mongodb": "workspace:*",
    "ai": "^7.0.55",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "mongodb": "^7.1.1",
    "redis": "^6.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
