AI_ASSIST_PORT=8080
AI_COMMERCE_PLATFORM=commercetools
AI_COMMERCE_SERVICE_URL=http://localhost:4000/graphql
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
DEFAULT_LLM_PROVIDER=openai
OPENAI_MODEL=openai/gpt-5.6-luna
ANTHROPIC_MODEL=anthropic/claude-sonnet-4-6
XAI_MODEL=xai/grok-4.5

# Structured logging level (@csa/logger): error | warn | info | debug
LOG_LEVEL=info

# ── Public voice widget (/voice/*) ──────────────────────────────────────────
# JSON map of widget key (>=16 chars) -> tenant. See src/voice/tenants.ts.
# Empty/unset disables the widget. Production also needs REDIS_URL (sessions fail closed without it).
# VOICE_WIDGET_TENANTS={"replace-with-a-long-random-key":{"projectKey":"my-project","allowedOrigins":["http://localhost:8080"],"serviceEmail":"voice-agent@example.com","brandName":"Example Store","lang":"en-US","knowledgeBase":false}}
VOICE_WIDGET_TENANTS=
# New sessions per IP per hour / per tenant per hour, and caller turns per session.
VOICE_SESSION_RATE_LIMIT=20
VOICE_TENANT_SESSION_LIMIT=500
VOICE_MAX_TURNS=40
# Serve the /voice/demo test page (defaults to on outside production).
# VOICE_DEMO_ENABLED=true

# Days after the order date within which a return is allowed (default 30).
# Raise it locally (e.g. 365) to test returns on older orders.
# RETURN_WINDOW_DAYS=30
