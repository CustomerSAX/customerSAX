{
  "name": "@csa/voice-widget",
  "version": "0.1.0",
  "private": true,
  "description": "Embeddable public voice support widget. Uses the browser's free Web Speech APIs; served by ai-assist at /voice/widget.js.",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --format=iife --target=es2019 --outfile=dist/csa-voice.js",
    "dev": "esbuild src/index.ts --bundle --format=iife --target=es2019 --outfile=dist/csa-voice.js --watch=forever",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.5.4"
  }
}
