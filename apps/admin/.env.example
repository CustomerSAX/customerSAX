ADMIN_PORT=4370

# MongoDB naming follows the current CSA standalone app / apps/auth's own .env.example.
MONGO_URI=
MONGO_ADMIN_DB=csa-admin
MONGO_ADMIN_COLLECTION=clients
MONGO_PROJECTS_COLLECTION=csa_projects
MONGO_SMTP_PROFILES_COLLECTION=csa_smtp_profiles
MONGO_ROLES_COLLECTION=csa_roles
MONGO_AI_SETTINGS_COLLECTION=csa_ai_settings
MONGO_AUDIT_COLLECTION=csa_audit_log
MONGO_AGENTS_DB=csa-agents
MONGO_USERS_COLLECTION=csa_users

# AES-256-GCM key for encrypting stored commerce/SMTP credentials at rest.
SUPERADMIN_ENCRYPTION_KEY=

# Outbound-email Cloud Function used by the SMTP-profile "test" action.
SEND_EMAIL_API=
TICKET_EMAIL_SEND_URL=
