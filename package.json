{
  "name": "customer-service-accelerator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "app:admin": "pnpm --filter @csa/admin",
    "app:ai-assist": "pnpm --filter @csa/ai-assist",
    "app:auth": "pnpm --filter @csa/auth",
    "app:bff": "pnpm --filter @csa/bff",
    "app:commerce-bigcommerce": "pnpm --filter @csa/commerce-bigcommerce",
    "app:commerce-commercetools": "pnpm --filter @csa/commerce-commercetools",
    "app:commerce-contract": "pnpm --filter @csa/commerce-contract",
    "app:commerce-sfcc": "pnpm --filter @csa/commerce-sfcc",
    "app:commerce-shopify": "pnpm --filter @csa/commerce-shopify",
    "app:ticketing": "pnpm --filter @csa/ticketing",
    "app:studio": "pnpm --filter @csa/studio",
    "app:marketing": "pnpm --filter marketing",
    "app:docs": "pnpm --filter @csa/docs-site",

    "clean": "turbo run clean",
    "clean:all": "turbo run clean && find . -name 'node_modules' -type d -prune -not -path './.git/*' -exec rm -rf {} + && rm -rf .turbo",
    "fresh": "pnpm run clean:all && pnpm install && pnpm run build",
    "clean:build": "pnpm run clean && pnpm run build",

    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:all": "pnpm turbo run dev --parallel --filter=@csa/commerce-commercetools --filter=@csa/bff --filter=@csa/studio --filter=@csa/auth --filter=@csa/ticketing --filter=@csa/admin --filter=@csa/ai-assist --filter=marketing --filter=@csa/docs-site",
    "dev:studio": "pnpm turbo run dev --parallel --filter=@csa/studio --filter=@csa/bff --filter=@csa/auth --filter=@csa/commerce-commercetools --filter=@csa/ticketing",
    "dev:marketing": "pnpm --filter marketing dev",
    "dev:docs": "pnpm --filter @csa/docs-site dev",

    "start": "turbo run start",
    "start:all": "pnpm turbo run start --filter=@csa/studio --filter=marketing --filter=@csa/docs-site --filter=@csa/bff --filter=@csa/auth --filter=@csa/admin --filter=@csa/ai-assist --filter=@csa/ticketing --filter=@csa/commerce-commercetools",
    "start:frontend": "pnpm turbo run start --filter=@csa/studio --filter=marketing --filter=@csa/docs-site",

    "cfg:prettier": "pnpm --filter @csa/config-prettier",
    "cfg:typescript": "pnpm --filter @csa/config-typescript",
    "format": "prettier --write --ignore-path=.gitignore .",
    "infra:gcp": "pnpm --filter @csa/infra-gcp",
    "lint": "turbo run lint",
    "test": "vitest run",
    "tf:check": "turbo run tf:check",
    "tf:format": "turbo run tf:format",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "prettier": "^3.3.3",
    "turbo": "^2.0.11",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.6.0"
}
