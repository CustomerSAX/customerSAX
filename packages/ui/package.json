{
  "name": "@csa/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./preset": {
      "types": "./src/preset/index.ts",
      "default": "./src/preset/index.ts"
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./status-card": {
      "types": "./src/status-card.tsx",
      "default": "./src/status-card.tsx"
    },
    "./*": "./src/*"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.15",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "tailwind-merge": "^2.5.2"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@csa/config-typescript": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.5.4"
  }
}
